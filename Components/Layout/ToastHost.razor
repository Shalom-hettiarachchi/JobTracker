@implements IDisposable
@inject ToastService Toasts

<div class="toasts" role="status" aria-live="polite">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="toast-item @toast.Level.ToString().ToLowerInvariant()" @key="toast.Id" @onclick="() => Toasts.Dismiss(toast.Id)">
            <Icon Name="@(toast.Level == ToastLevel.Error ? "x" : "check")" />
            @toast.Message
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= Refresh;
}
